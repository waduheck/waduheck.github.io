{
  "name": "portfolio-homepage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portfolio: design-token driven, Storybook component library, React + Vite",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tokens": "npm run build -w @portfolio/tokens",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build --output-dir storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "storybook": "^10.6.5",
    "style-dictionary": "^5.7.1",
    "vite": "8.3.4"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
